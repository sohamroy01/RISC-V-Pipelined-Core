// program.mem
// Address | Machine Code | Assembly Equivalent     | What this tests
00500093 // 00:          addi x1, x0, 5        | x1 = 5
00A00113 // 04:          addi x2, x0, 10       | x2 = 10
002081B3 // 08:          add  x3, x1, x2       | x3 = 15 (Tests EX/MEM Forwarding from x2)
00302023 // 0C:          sw   x3, 0(x0)        | mem[0] = 15 (Tests MEM/WB Forwarding from x3)
00002203 // 10:          lw   x4, 0(x0)        | x4 = 15 (Loads 15 back from memory)
00320233 // 14:          add  x4, x4, x3       | x4 = 15 + 15 = 30 (TESTS LOAD-USE STALL!)
00000013 // 18:          nop                   | Pipeline drain
00000013 // 1C:          nop                   | Pipeline drain
00000013 // 20:          nop                   | Pipeline drain